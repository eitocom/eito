# =============================================================================
# Desenvolvimento local (Supabase CLI + Docker — após `yarn db:start`)
# =============================================================================

# Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# Produção (Vercel): use o Connection Pooler (Transaction, porta 6543), NÃO o Direct.
# Dashboard → Connect → Connection string → Transaction pooler
# Ex.: postgresql://postgres.<project-ref>:<SENHA>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Host db.<ref>.supabase.co:5432 é IPv6 e a Vercel não alcança → /auth/callback trava ("This page isn’t working").

# Supabase API
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# Preencha com `supabase status -o env` → ANON_KEY (ou PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Obrigatória para OAuth mock local: `supabase status -o env` → SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:3000"

# OAuth — GitHub (https://github.com/settings/developers)
# Authorization callback URL (local): http://127.0.0.1:54321/auth/v1/callback
# Em desenvolvimento, se CLIENT_ID estiver vazio, o login social usa mock local.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI (local): http://127.0.0.1:54321/auth/v1/callback
# Em desenvolvimento, se CLIENT_ID estiver vazio, o login social usa mock local.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# Produção (Vercel + Supabase cloud) — configurar no painel da Vercel
# =============================================================================
#
# Copie estes nomes de variáveis no projeto Vercel (Production + Preview).
# Não use os valores locais acima em produção.
#
# DATABASE_URL=
#   URI do Postgres do Supabase (Settings → Database).
#   - Para a app na Vercel (serverless): use o Transaction pooler (porta 6543)
#     e acrescente ?pgbouncer=true (e schema=public se necessário).
#   - Para `yarn db:push` / migrations na sua máquina: use a Direct connection
#     (porta 5432).
#
# NEXT_PUBLIC_SUPABASE_URL=
#   Project URL (Settings → API), ex.: https://xxxxx.supabase.co
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#   anon / publishable key (Settings → API)
#
# SUPABASE_SERVICE_ROLE_KEY=
#   service_role key (Settings → API) — apenas server-side; nunca exponha no client
#
# NEXT_PUBLIC_APP_URL=
#   URL canônica da app na Vercel, ex.: https://seu-projeto.vercel.app
#   (sem barra no final)
#
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
#   OAuth App do GitHub. Em produção o mock não roda: configure o provider no
#   Supabase (Authentication → Providers) com callback:
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback
#
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
#   Opcional; mesmo padrão do GitHub no Supabase Authentication → Providers.
#
# No Supabase (Authentication → URL Configuration):
#   Site URL: https://seu-projeto.vercel.app
#   Redirect URLs: https://seu-projeto.vercel.app/auth/callback
#   (opcional preview: https://*-seu-time.vercel.app/auth/callback)
#
# Aplicar o schema Prisma no banco cloud (uma vez, da sua máquina):
#   DATABASE_URL="<direct-connection-uri>" yarn db:push
